# OpenAI Platform에서 발급한 키
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

BLOG_URL=https://active-log.tistory.com
BLOG_NAME=active-log

# 검토 완료 후 즉시 공개 게시
PUBLISH_VISIBILITY=public
AUTO_PUBLISH=false

MIN_INTERVAL_DAYS=1
MAX_INTERVAL_DAYS=3
TIMEZONE=Asia/Seoul

# 최초 로그인 때 false로 바꿔 브라우저에서 로그인하고, 이후 true 권장
TISTORY_HEADLESS=true
TISTORY_PROFILE_DIR=playwright-profile

DATABASE_PATH=data/active_log.db
HOST=127.0.0.1
PORT=8000

# Instagram Login 방식의 프로페셔널 계정 토큰 (비밀번호 아님)
# instagram_business_basic, instagram_business_content_publish 권한 필요
INSTAGRAM_ACCESS_TOKEN=
# 선택: 연결 대상 계정 ID를 고정하면 다른 계정 토큰 사용을 차단
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v25.0
# true이면 티스토리 공개 게시 성공 후 카드 6장 자동 연동
INSTAGRAM_AUTO_PUBLISH=false
# 빈 값이면 게시 중에 Cloudflare Quick Tunnel로 카드 JPEG만 임시 제공
INSTAGRAM_MEDIA_DIR=output/instagram-public
INSTAGRAM_MEDIA_BASE_URL=
# 선택: 직접 설치한 cloudflared 실행 파일 경로. 생략하면 필요할 때 공식 릴리스에서 다운로드
# CLOUDFLARED_PATH=C:\tools\cloudflared.exe
