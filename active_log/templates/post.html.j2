<article class="activelog-post" data-schema-version="{{ post.schema_version }}">
<style>
.activelog-post{max-width:860px;margin:0 auto;color:#222;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans KR","Malgun Gothic",sans-serif;line-height:1.8;word-break:keep-all;overflow-wrap:anywhere}
.activelog-post *{box-sizing:border-box}.activelog-post .breadcrumb{margin:0 0 18px;color:#249447;font-size:13px;font-weight:600}
.activelog-post h1{margin:0 0 12px;font-size:38px;line-height:1.3;letter-spacing:-1.5px}.activelog-post .meta{color:#888;font-size:13px;margin-bottom:28px}
.activelog-post .image-wrap{margin:24px 0}.activelog-post img{display:block;width:100%;height:auto;border-radius:8px}.activelog-post .image-placeholder{padding:34px 18px;border:1px dashed #b7c7ba;border-radius:8px;background:#f7faf7;color:#647067;text-align:center;font-size:13px}
.activelog-post .intro{font-size:16px;margin:24px 0}.activelog-post .notice{margin:24px 0 42px;padding:14px 18px;border-radius:8px;background:#eef8ef;border:1px solid #d8ecd9;color:#315d35;font-size:14px}
.activelog-post .section{margin-top:54px;padding-top:8px;border-top:1px solid #e8e8e8}.activelog-post h2{margin:0 0 22px;padding-left:13px;border-left:5px solid #249447;font-size:28px;line-height:1.35}
.activelog-post .october h2{border-left-color:#f26b21}.activelog-post .november h2{border-left-color:#333}
.activelog-post h3{margin:30px 0 8px;font-size:21px;line-height:1.45}.activelog-post .event{margin:18px 0 30px;padding-bottom:24px;border-bottom:1px solid #eee}.activelog-post .event-info{margin:8px 0 10px;padding-left:16px;border-left:3px solid #249447}.activelog-post .event-info p{margin:2px 0}.activelog-post .event-info strong{display:inline-block;width:54px}
.activelog-post .tip-box{margin:24px 0;padding:20px 22px;border:1px solid #eee;border-radius:8px;background:#fafafa}.activelog-post .tip-box ul{margin:0;padding-left:22px}.activelog-post .tip-box li+li{margin-top:8px}
.activelog-post .table-scroll{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}.activelog-post table{width:100%;min-width:650px;border-collapse:collapse;margin:24px 0;font-size:14px}.activelog-post th,.activelog-post td{padding:12px 10px;border:1px solid #e5e5e5;text-align:center}.activelog-post th{background:#f7f7f7}.activelog-post .hashtags{margin:48px 0 10px;color:#247a3c}.activelog-post .hashtags span{display:inline-block;margin:0 8px 8px 0}
@media(max-width:700px){.activelog-post{line-height:1.72}.activelog-post h1{font-size:28px;letter-spacing:-1px}.activelog-post h2{font-size:23px}.activelog-post h3{font-size:19px}.activelog-post .section{margin-top:42px}.activelog-post table{font-size:12px}.activelog-post th,.activelog-post td{padding:8px 5px}}
</style>
<nav class="breadcrumb" aria-label="카테고리">홈 &nbsp;&rsaquo;&nbsp; {{ post.category }} &nbsp;&rsaquo;&nbsp; {{ post.subcategory }}</nav>
<header><h1>{{ post.title }}</h1><div class="meta">{{ post.blog_name }} &nbsp; | &nbsp; {{ post.date }} &nbsp; | &nbsp; {{ post.views_text }}</div></header>
{% set hero = image_for('hero') %}{% if hero %}<div class="image-wrap" data-image-slot="hero">{% if hero.tistory_tag %}{{ hero.tistory_tag|safe }}{% else %}<!-- ACTIVELOG_IMAGE:hero filename={{ hero.filename }} alt={{ hero.alt }} --><div class="image-placeholder">대표 이미지 · {{ hero.filename }}</div>{% endif %}</div>{% endif %}
<p class="intro">{{ post.intro }}</p><aside class="notice"><strong>일정 변경 안내</strong><br>{{ post.notice }}</aside>
{% for section in post.sections %}<section class="section{% if section.id in ['october','november'] %} {{ section.id }}{% endif %}" id="{{ section.id }}"><h2 data-ke-size="size26">{{ section.title }}</h2>
{% if section.lead %}<p>{{ section.lead }}</p>{% endif %}
{% if section.image_slot %}{% set image = image_for(section.image_slot) %}{% if image %}<div class="image-wrap" data-image-slot="{{ image.slot }}">{% if image.tistory_tag %}{{ image.tistory_tag|safe }}{% else %}<!-- ACTIVELOG_IMAGE:{{ image.slot }} filename={{ image.filename }} alt={{ image.alt }} --><div class="image-placeholder">{{ image.alt }} · {{ image.filename }}</div>{% endif %}</div>{% endif %}{% endif %}
{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
{% for event in section.events %}<div class="event"><h3 data-ke-size="size23">{{ event.name }}</h3><div class="event-info"><p data-ke-size="size16"><strong>일시</strong>{{ event.date }}</p><p data-ke-size="size16"><strong>장소</strong>{{ event.location }}</p><p data-ke-size="size16"><strong>종목</strong>{{ event.distances }}</p><p data-ke-size="size16"><strong>접수</strong>{{ event.registration }}</p></div><p data-ke-size="size16">{{ event.description }}</p>{% if event.official_url %}<p><a href="{{ event.official_url }}" target="_blank" rel="noopener noreferrer">공식 안내 확인</a></p>{% endif %}</div>{% endfor %}
{% if section.id == 'schedule' %}<div class="table-scroll"><table><thead><tr><th>월</th><th>대회명</th><th>일정</th><th>지역</th><th>종목</th></tr></thead><tbody>{% for month_section in post.sections %}{% if month_section.id in ['september','october','november'] %}{% for event in month_section.events %}<tr><td>{{ {'september':'9월','october':'10월','november':'11월'}[month_section.id] }}</td><td>{{ event.name }}</td><td>{{ event.date }}</td><td>{{ event.location }}</td><td>{{ event.distances }}</td></tr>{% endfor %}{% endif %}{% endfor %}</tbody></table></div>{% endif %}
{% if section.bullets %}<div class="tip-box"><ul>{% for item in section.bullets %}<li>{{ item }}</li>{% endfor %}</ul></div>{% endif %}</section>{% endfor %}
<footer class="hashtags" aria-label="해시태그">{% for tag in post.hashtags %}<span>#{{ tag.lstrip('#') }}</span>{% endfor %}</footer>
</article>
